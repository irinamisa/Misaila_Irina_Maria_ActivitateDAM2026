<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bun_venit_in_aplicatie"
        android:textAlignment="center"/>

    <Button
        android:id="@+id/adaugaBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adauga_un_automobil"
        android:backgroundTint="@color/buton"/>

    <Button
        android:id="@+id/afiseaza_Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/afiseaza_automobilele"
        android:backgroundTint="@color/buton"/>
</LinearLayout>