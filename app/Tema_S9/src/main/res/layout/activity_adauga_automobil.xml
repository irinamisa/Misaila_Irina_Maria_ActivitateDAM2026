<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdaugaAutomobil"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/formular_de_adaugare_automobil"
        android:textAlignment="center"
        android:textSize="25dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/id_automobil"/>

    <EditText
        android:id="@+id/id_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introdu_id_ul_automobilului"
        android:background="@color/view"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/marca"/>

    <Spinner
        android:id="@+id/marca_SP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/view"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/model"/>

    <EditText
        android:id="@+id/model_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introdu_modelul"
        android:background="@color/view"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/capacitate"/>

    <EditText
        android:id="@+id/capacitate_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/introdu_capacitatea"
        android:background="@color/view" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/an_fabricatie"/>

    <NumberPicker
        android:id="@+id/anFabricatie_NP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/view"/>

    <CheckBox
        android:id="@+id/esteElectric_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/este_electric"/>

    <Button
        android:id="@+id/salveaza_BTN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salveaza_automobilul"
        android:backgroundTint="@color/buton"/>


</LinearLayout>